{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["@tarojs/taro", "@types/webpack-env"],
    "paths": {
      "@sm/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "types", "config"]
}
